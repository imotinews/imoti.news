# Copy to .env and fill in real values.

# Supabase Postgres connection string (Settings -> Database -> Connection string)
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# NextAuth v5 (admin panel) — random secret, e.g. `openssl rand -base64 32`
AUTH_SECRET=""

# AI rewrite provider: "anthropic" (Claude Haiku) or "gemini" (Gemini 2.5 Flash-Lite, free tier)
AI_PROVIDER="gemini"
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Scraper cron endpoint auth — random secret, e.g. `openssl rand -base64 24`
CRON_SECRET=""

# Newsletter
RESEND_API_KEY=""
