# Copy to .env and fill in real values.

# Supabase Postgres connection string (Settings -> Database -> Connection string)
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# NextAuth v5 (admin panel) — random secret, e.g. `openssl rand -base64 32`
AUTH_SECRET=""

# AI rewrite provider: "anthropic" (Claude Haiku) or "gemini" (Gemini 2.5 Flash-Lite, free tier)
AI_PROVIDER="gemini"
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Scraper cron endpoint auth — random secret, e.g. `openssl rand -base64 24`
CRON_SECRET=""

# Newsletter (Resend — resend.com/api-keys)
RESEND_API_KEY=""
NEWSLETTER_FROM_EMAIL="imoti.news <onboarding@resend.dev>"

# Public site URL — used to build links in emails
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Google AdSense (optional) — leave blank until approved. Publisher ID looks like ca-pub-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
