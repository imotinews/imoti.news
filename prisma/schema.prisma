generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  draft
  published
}

enum SourceType {
  rss
  scrape
}

enum SourceContentType {
  real_estate
  lifestyle
}

enum ScrapeStatus {
  created
  irrelevant
  similar_duplicate
  too_old
  error
}

enum AdPosition {
  header
  sidebar
  in_article
  footer
}

enum AdminRole {
  admin
  editor
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  scrapable   Boolean      @default(true)
  articles    Article[]
  stockPhotos StockPhoto[]

  @@map("categories")
}

model SocialLinks {
  id         String   @id @default(cuid())
  facebook   String?
  instagram  String?
  x          String?
  linkedin   String?
  youtube    String?
  tiktok     String?
  telegram   String?
  viber      String?
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("social_links")
}

model Source {
  id          String            @id @default(cuid())
  name        String
  url         String
  type        SourceType
  contentType SourceContentType @default(real_estate) @map("content_type")
  active      Boolean           @default(true)
  articles    Article[]
  scrapedUrls ScrapedUrl[]

  @@map("sources")
}

model Article {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  excerpt           String?
  imageUrl          String?       @map("image_url")
  rewrittenContent  String        @map("rewritten_content")
  originalUrl       String        @map("original_url")
  sourceName        String        @map("source_name")
  categoryId        String?       @map("category_id")
  category          Category?     @relation(fields: [categoryId], references: [id])
  sourceId          String?       @map("source_id")
  source            Source?       @relation(fields: [sourceId], references: [id])
  status            ArticleStatus @default(draft)
  publishedAt       DateTime?     @map("published_at")
  aiGenerated       Boolean       @default(false) @map("ai_generated")
  isHero            Boolean       @default(false) @map("is_hero")
  isFeatured        Boolean       @default(false) @map("is_featured")
  isOriginal        Boolean       @default(false) @map("is_original")
  photos            ArticlePhoto[]
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([sourceId])
  @@map("articles")
}

model ArticlePhoto {
  id        String   @id @default(cuid())
  articleId String   @map("article_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  imageUrl  String   @map("image_url")
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([articleId])
  @@map("article_photos")
}

model ScrapedUrl {
  id           String       @id @default(cuid())
  url          String       @unique
  status       ScrapeStatus @default(created)
  title        String?
  errorMessage String?      @map("error_message")
  sourceId     String?      @map("source_id")
  source       Source?      @relation(fields: [sourceId], references: [id])
  articleId    String?      @map("article_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([sourceId, createdAt])
  @@map("scraped_urls")
}

model SiteContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_content")
}

model MarketWatch {
  id        String   @id @default(cuid())
  summary   String
  imageUrl  String?  @map("image_url")
  stats     Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("market_watch")
}

model StockPhoto {
  id         String    @id @default(cuid())
  imageUrl   String    @map("image_url")
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([categoryId, lastUsedAt])
  @@map("stock_photos")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")
  confirmed    Boolean  @default(false)
  token        String   @unique @default(cuid())

  @@map("newsletter_subs")
}

model NewsletterSend {
  id             String   @id @default(cuid())
  subject        String
  recipientCount Int      @map("recipient_count")
  sentAt         DateTime @default(now()) @map("sent_at")

  @@map("newsletter_sends")
}

model AdBanner {
  id         String     @id @default(cuid())
  name       String
  imageUrl   String?    @map("image_url")
  htmlCode   String?    @map("html_code")
  targetUrl  String?    @map("target_url")
  position   AdPosition
  startDate  DateTime?  @map("start_date")
  endDate    DateTime?  @map("end_date")
  active     Boolean    @default(true)
  impressions Int       @default(0)
  clicks     Int        @default(0)

  @@index([position, active])
  @@map("ad_banners")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(admin)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("admin_users")
}
