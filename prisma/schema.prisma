generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  draft
  published
}

enum SourceType {
  rss
  scrape
}

enum SourceContentType {
  real_estate
  lifestyle
}

enum ScrapeStatus {
  created
  irrelevant
  similar_duplicate
  error
}

enum AdPosition {
  header
  sidebar
  in_article
  footer
}

enum AdminRole {
  admin
  editor
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  articles Article[]

  @@map("categories")
}

model Source {
  id          String            @id @default(cuid())
  name        String
  url         String
  type        SourceType
  contentType SourceContentType @default(real_estate) @map("content_type")
  active      Boolean           @default(true)
  articles    Article[]
  scrapedUrls ScrapedUrl[]

  @@map("sources")
}

model Article {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  excerpt           String?
  rewrittenContent  String        @map("rewritten_content")
  originalUrl       String        @map("original_url")
  sourceName        String        @map("source_name")
  categoryId        String?       @map("category_id")
  category          Category?     @relation(fields: [categoryId], references: [id])
  sourceId          String?       @map("source_id")
  source            Source?       @relation(fields: [sourceId], references: [id])
  status            ArticleStatus @default(draft)
  publishedAt       DateTime?     @map("published_at")
  aiGenerated       Boolean       @default(false) @map("ai_generated")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([sourceId])
  @@map("articles")
}

model ScrapedUrl {
  id           String       @id @default(cuid())
  url          String       @unique
  status       ScrapeStatus @default(created)
  title        String?
  errorMessage String?      @map("error_message")
  sourceId     String?      @map("source_id")
  source       Source?      @relation(fields: [sourceId], references: [id])
  articleId    String?      @map("article_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([sourceId, createdAt])
  @@map("scraped_urls")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")
  confirmed    Boolean  @default(false)
  token        String   @unique @default(cuid())

  @@map("newsletter_subs")
}

model NewsletterSend {
  id             String   @id @default(cuid())
  subject        String
  recipientCount Int      @map("recipient_count")
  sentAt         DateTime @default(now()) @map("sent_at")

  @@map("newsletter_sends")
}

model AdBanner {
  id         String     @id @default(cuid())
  name       String
  imageUrl   String?    @map("image_url")
  htmlCode   String?    @map("html_code")
  targetUrl  String?    @map("target_url")
  position   AdPosition
  startDate  DateTime?  @map("start_date")
  endDate    DateTime?  @map("end_date")
  active     Boolean    @default(true)
  impressions Int       @default(0)
  clicks     Int        @default(0)

  @@index([position, active])
  @@map("ad_banners")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(admin)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("admin_users")
}
